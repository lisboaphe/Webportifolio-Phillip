# Password visitors type to unlock the résumé PDFs.
RESUME_PASSWORD=
# Long random string used to sign the résumé cookie and the contact captcha.
# Generate one with: openssl rand -hex 32
SITE_SECRET=
# Contact form email delivery via https://resend.com (free tier is enough).
RESEND_API_KEY=
# Optional: where messages go (defaults to lisboaphe@gmail.com) and the sender.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
